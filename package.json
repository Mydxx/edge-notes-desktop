{
  "name": "edge-notes-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Edge Notes Desktop - 桌面边缘笔记栏（原生窗口贴边滑出 + 本地笔记）",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "start": "npm run build && electron .",
    "test:window": "node tests/window.e2e.mjs",
    "test:notes": "node tests/notes.e2e.mjs",
    "test:visual": "node tests/visual.e2e.mjs",
    "test:desktop": "node tests/desktop.e2e.mjs",
    "gen:icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/gen-tray-icon.ps1",
    "gen:app-icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/gen-app-icon.ps1",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "test:packaged": "node tests/packaged.e2e.mjs",
    "test:installer": "node tests/installer.e2e.mjs",
    "test:e2e": "npm run build && node tests/window.e2e.mjs && node tests/notes.e2e.mjs && node tests/desktop.e2e.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.8.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
